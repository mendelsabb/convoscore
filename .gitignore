# Secrets and local configuration — never commit real values
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
*.egg-info/

# Node / frontend
node_modules/
dist/
build/

# Terraform (state stays local and untracked; the provider lock file is committed)
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
crash.log

# Editors / OS
.DS_Store
.vscode/
.idea/
*.log
