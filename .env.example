# Copy this file to .env and fill in real values. .env is gitignored and is never committed.
# `make up` turns these into Kubernetes Secrets / Helm values; nothing here is baked into images.

# Required unless LLM_PROVIDER=fake
OPENAI_API_KEY=sk-replace-me

# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-4.1-mini
# LLM_PROVIDER=openai        # "fake" runs the whole stack with a deterministic provider and zero OpenAI spend
# DEMO_MODE=true             # enables the demo-only failure-injection API and UI page
