"130" width="150" height="80" as="geometry"/></mxCell><mxCell id="ecr" value="ECR&lt;br&gt;scan on push, immutable tags" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=6;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;whiteSpace=wrap;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="190" y="320" width="60" height="60" as="geometry"/></mxCell><mxCell id="sm" value="Secrets Manager&lt;br&gt;OpenAI key, DB creds, rotation" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=2;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;whiteSpace=wrap;labelWidth=140;" vertex="1" parent="1"><mxGeometry x="190" y="450" width="60" height="60" as="geometry"/></mxCell><mxCell id="alb" value="Application Load Balancer&lt;br&gt;TLS via ACM" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;whiteSpace=wrap;labelWidth=170;" vertex="1" parent="g_pub"><mxGeometry x="95" y="20" width="60" height="60" as="geometry"/></mxCell><mxCell id="nat" value="NAT Gateway (per AZ)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nat_gateway;whiteSpace=wrap;