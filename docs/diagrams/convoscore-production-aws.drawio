<mxfile host="app.diagrams.net" type="device" compressed="false"><diagram id="ConvoScore production (AWS)" name="ConvoScore production (AWS)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;ConvoScore &amp;#8212; production architecture on AWS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Same application code; the endpoints, identities and operational guarantees underneath it change. Two AZs shown, three in production." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="1100" height="40" as="geometry"/></mxCell><mxCell id="g_cloud" value="AWS account (us-east-1)" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeColor=#232F3E;fillColor=none;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=34;spacingTop=2;spacingBottom=4;fontStyle=1;fontColor=#232F3E;fontSize=13;dashed=0;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="1440" height="860" as="geometry"/></mxCell><mxCell id="g_vpc" value="VPC" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeColor=#8C4FFF;fillColor=none;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=34;spacingTop=2;spacingBottom=4;fontStyle=1;fontColor=#232F3E;fontSize=13;dashed=0;" vertex="1" parent="g_cloud"><mxGeometry x="20" y="40" width="1000" height="680" as="geometry"/></mxCell><mxCell id="g_pub" value="Public subnets" style="rounded=0;html=1;whiteSpace=wrap;container=1;collapsible=0;strokeColor=#7AA116;fillColor=#F2F8EC;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spac