ed=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacing=4;dashed=1;arcSize=10;" vertex="1" parent="g_eks"><mxGeometry x="740" y="175" width="150" height="70" as="geometry"/></mxCell><mxCell id="keda" value="&lt;b&gt;KEDA&lt;/b&gt; &amp;#8212; worker replicas from&lt;br&gt;SQS depth + age, capped by rate limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacing=4;dashed=1;arcSize=10;" vertex="1" parent="g_eks"><mxGeometry x="20" y="175" width="200" height="36" as="geometry"/></mxCell><mxCell id="karpenter" value="&lt;b&gt;Karpenter&lt;/b&gt; &amp;#8212; node capacity&lt;br&gt;(secondary)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacing=4;dashed=1;arcSize=10;" vertex="1" parent="g_eks"><mxGeometry x="20" y="217" width="200" height="32" as="geometry"/></mxCell><mxCell id="rds_a" value="primary &amp;#8212; AZ a" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=2;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;whiteSpace=wrap;labelWidth=120;" vertex="1" parent="g_rds"><mxGeometry x="50" y="22" width="56" height="56" as="geometry"/></mxCell><mxCell id="rds_b" value="standby &amp;#8212; AZ b" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=2;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;whiteSpace=wrap;labelWidth=120;" vertex="1" parent="g_rds"><mxGeometry x="400" y="22" width="56" height="56" as="geometry"/></mxCell><mxCell id="t_vpce" value="&lt;b&gt;VPC endpoints&lt;/b&gt;&lt;br&gt;S3 (gateway); SQS, ECR,&lt;br&gt;Secrets Manager, CloudWatch (interface)&lt;br&gt;&amp;#8212; AWS traffic never leaves the VPC" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="400" y="610" width="190" height="90" as="geometry"/></mxCell><mxCell id="s3" value="S3 conversations bucket&lt;br&gt;SSE-KMS, retention policy" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=2;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;whiteSpace=wrap;labelWidth=150;" vertex="1" parent="g_cloud"><mxGeometry x="1130" y="70" width="60" height="60" as="geometry"/></mxCell><mxCell id="sqs_in" value="SQS ingest queue" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=2;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;whiteSpace=wrap;labelWidth=150;" vertex="1" parent="g_cloud"><mxGeometry x="1130" y="230" width="60" height="60" as="geometry"/></mxCell><mxCell id="sqs_score" value="SQS scoring queue" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=2;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;whiteSpace=wrap;labelWidth=150;" vertex="1" parent="g_cloud"><mxGeometry x="1130" y="340" width="60" height="60" as="geometry"/></mxCell><mxCell id="dlq" value="dead-letter queue" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=2;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;whiteSpace=wrap;labelWidth=150;" vertex="1" parent="g_cloud"><mxGeometry x="1340" y="340" width="60" height="60" as="geometry"/></mxCell><mxCell id="iam" value="IAM via EKS Pod Identity&lt;br&gt;one least-privilege role per component" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=2;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;whiteSpace=wrap;labelWidth=150;" vertex="1" parent="g_cloud"><mxGeometry x="1150" y="480" width="60" height="60" as="geometry"/></mxCell><mxCell id="cw" value="CloudWatch&lt;br&gt;SQS depth, RDS, ALB, logs" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=2;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch;whiteSpace=wrap;labelWidth=150;" vertex="1" parent="g_cloud"><mxGeometry x="1340" y="480" width="60" height="60" as="geometry"/></mxCell><mxCell id="amp" value="Managed Prometheus&lt;br&gt;(or Prometheus Operator)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=2;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.managed_service_for_prometheus;whiteSpace=wrap;labelWidth=150;" vertex="1" parent="g_cloud"><mxGeometry x="1130" y="630" width="60" height="60" as="geometry"/></mxCell><mxCell id="amg" value="Managed Grafana&lt;br&gt;same dashboard JSON" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;spacingTop=2;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.managed_service_for_grafana;whiteSpace=wrap;labelWidth=150;" vertex="1" parent="g_cloud"><mxGeometry x="1340" y="630" width="60" height="60" as="geometry"/></mxCell><mxCell id="ci" value="&lt;b&gt;CI (GitHub Actions)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;lint, tests, image build &amp;#8594; push to ECR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacing=4;dashed=1;arcSize=10;" vertex="1" parent="g_deliver"><mxGeometry x="20" y="37" width="230" height="64" as="geometry"/></mxCell><mxCell id="terraform" value="&lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;VPC, EKS, RDS, S3, SQS, IAM, ECR&lt;br&gt;remote state in S3 + lock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacing=4;dashed=1;arcSize=10;" vertex="1" parent="g_deliver"><mxGeometry x="280" y="37" width="230" height="64" as="geometry"/></mxCell><mxCell id="gitops" value="&lt;b&gt;Git: Helm chart + env values&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ArgoCD watches this&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#8C8C8C;strokeWidth=1.5;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacing=4;dashed=1;arcSize=10;" vertex="1" parent="g_deliver"><mxGeometry x="540" y="37" width="230" height="64" as="geometry"/></mxCell><mxCell id="t_migrate" value="Migrations run as a pipeline step against RDS before rollout, not in a pod." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="1150" y="838" width="190" height="60" as="geometry"/></mxCell><mxCell id="t_sec" value="&lt;b&gt;Security posture&lt;/b&gt;&lt;br&gt;&amp;#8226; Only the ALB is public; EKS and RDS private&lt;br&gt;&amp;#8226; Egress to OpenAI only via NAT, TLS 443&lt;br&gt;&amp;#8226; No static AWS keys: Pod Identity&lt;br&gt;&amp;#8226; Secrets via External Secrets Operator&lt;br&gt;&amp;#8226; KMS at rest, TLS in transit&lt;br&gt;&amp;#8226; Security groups chained ALB &amp;#8594; nodes &amp;#8594; RDS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="250" height="170" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1F77B4&quot;&gt;&lt;b&gt;&amp;#9473;&amp;#9473;&amp;#9473;&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Direct API path&lt;br&gt;&lt;font color=&quot;#2CA02C&quot;&gt;&lt;b&gt;&amp;#9473;&amp;#9473;&amp;#9473;&lt;/b&gt;&lt;/font&gt;&amp;nbsp; Event-driven ingestion path&lt;br&gt;&lt;font color=&quot;#4D8F3A&quot;&gt;&lt;b&gt;&amp;#9473;&amp;#9473;&amp;#9473;&lt;/b&gt;&lt;/font&gt;&amp;nbsp; persistence&lt;br&gt;&lt;font color=&quot;#E69138&quot;&gt;&lt;b&gt;&amp;#8211; &amp;#8211; &amp;#8211;&lt;/b&gt;&lt;/font&gt;&amp;nbsp; observability (pull)&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;&lt;b&gt;&amp;#8211; &amp;#8211; &amp;#8211;&lt;/b&gt;&lt;/font&gt;&amp;nbsp; secrets / identity&lt;br&gt;&lt;font color=&quot;#7F7F7F&quot;&gt;&lt;b&gt;&amp;#8211; &amp;#8211; &amp;#8211;&lt;/b&gt;&lt;/font&gt;&amp;nbsp; delivery: provisioning, images, GitOps" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;strokeColor=n