<mxfile host="app.diagrams.net" type="device" compressed="false"><diagram id="ConvoScore local (kind)" name="ConvoScore local (kind)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_title" value="&lt;font style=&quot;font-size:20px&quot;&gt;&lt;b&gt;ConvoScore &amp;#8212; local architecture&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Everything runs in one kind cluster on the laptop. The only call that leaves the machine is to OpenAI." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;strokeColor=none;fillColor=none;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="40" as="geometry"/></mxCell><mxCell id="g_ext" value="Reviewer / operator" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontSize=13;fontStyle=1;fontColor=#333333;dashed=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="200" height="810" as="geometry"/></mxCell><mxCell id="g_k8s" value="kind cluster &amp;#8220;convoscore&amp;#8221; &amp;#8212; workloads deployed by the Helm chart; NodePorts mapped to 127.0.0.1" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#F3F7FC;strokeColor=#9DB6D9;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=4;spacingBottom=4;fontSize=14;fontStyle=1;fontColor=#333333;dashed=0;arcSize=6;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="960" height="745" as="geometry"/></mxCell><mxCell id="g_app" value="namespace: convoscore" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=1.5;verticalAlign=top;align=le